# Fill credentials locally; never paste real values into chat or commit .env.
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=

# Comma-separated numeric IDs. Empty lists refuse startup.
OWNER_IDS=
SOURCE_CHAT_IDS=

# Optional: restrict /login to one owner (defaults to smallest OWNER_IDS entry).
# LOGIN_OWNER_ID=
LOGIN_TIMEOUT_SECONDS=300

# Separate private user and bot sessions, outside the checkout.
SESSION_DIR=/workspace/private/save-restricted-test
# Optional overrides: TG_SESSION and TG_BOT_SESSION.
TRANSFER_WORKERS=1
MAX_CONCURRENT_TRANSFERS=1
MAX_FILE_BYTES=1999999999

# Optional restart restoration only; /login works without session exports.
# Do not commit or print actual encoded values. See HEROKU.md.
# TG_USER_SESSION_B64=
# TG_BOT_SESSION_B64=
