# Fill credentials locally; never paste real values into chat or commit .env.
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=

# Comma-separated numeric IDs. Empty lists refuse startup.
OWNER_IDS=
SOURCE_CHAT_IDS=

# Separate private user and bot sessions, outside the checkout.
SESSION_DIR=/workspace/private/save-restricted-test
# Optional overrides: TG_SESSION and TG_BOT_SESSION.
TRANSFER_WORKERS=1
MAX_CONCURRENT_TRANSFERS=1
MAX_FILE_BYTES=1999999999
